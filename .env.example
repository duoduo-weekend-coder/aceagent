# ── Gemini ────────────────────────────────────────────────────────────────────
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── OpenAI (optional — only needed if you select GPT-4o-mini in the UI) ───────
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Twilio ────────────────────────────────────────────────────────────────────
# Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=      # E.164 format, e.g. +14155551234

# ── Email (optional) ──────────────────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ── Deployment (optional) ─────────────────────────────────────────────────────
# Override the public URL used for Twilio webhooks.
# Leave blank — the server auto-detects it from the Host header (Railway/Fly.io)
# or from ngrok's local API when running locally.
# BASE_URL=https://your-app.up.railway.app
